NODE_ENV=production
# Hostname for Caddy TLS. Use :80 for HTTP-only. <vm-ip>.sslip.io works without a purchased domain.
PUBLIC_HOST=sentinel.example.com
ACME_EMAIL=you@example.com

# Supabase: transaction pooler (6543) for api/worker.
# Session pooler (5432, same pooler host) for migrate — db.*.supabase.co is IPv6-only.
# Include ?sslmode=require. The client verifies the bundled Supabase CA.
DATABASE_URL=postgres://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_DIRECT_URL=postgres://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
REDIS_URL=redis://redis:6379

API_PORT=3001
WEB_PORT=3000

# Required in production. Minimum 12 characters. Never NEXT_PUBLIC_.
APP_PASSWORD=change-me-now-please

# Server-side only. Never NEXT_PUBLIC_.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_ACCOUNT_TYPE=real
DEMO_EXECUTION_ENABLED=false
ETORO_REST_BASE_URL=https://public-api.etoro.com
ETORO_WS_URL=wss://ws.etoro.com/ws
STALE_TICK_MS=15000

# Optional Telegram. Never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional image registry. Leave unset to build locally as market-sentinel/*.
# IMAGE_HOST=us-central1-docker.pkg.dev/PROJECT/market-sentinel
# IMAGE_TAG=local
