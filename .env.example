NODE_ENV=development
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/market_sentinel
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_PORT=3000
# Optional. Unset is an insecure local default — do not expose the API without it.
# Never prefix with NEXT_PUBLIC_. Minimum 12 characters when set.
APP_PASSWORD=

# Server-side only. Never prefix with NEXT_PUBLIC_.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_ACCOUNT_TYPE=real
# Server-side only. Default false. Must be true AND ETORO_ACCOUNT_TYPE=demo AND APP_PASSWORD set to send Demo orders.
# Never prefix with NEXT_PUBLIC_.
DEMO_EXECUTION_ENABLED=false
ETORO_REST_BASE_URL=https://public-api.etoro.com
ETORO_WS_URL=wss://ws.etoro.com/ws
STALE_TICK_MS=15000

# Server-side only. Never prefix with NEXT_PUBLIC_. Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
